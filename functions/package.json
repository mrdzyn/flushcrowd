{
  "name": "flushcrowd-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/src/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "smoke:entrypoint": "APP_ENV=test node -e \"require('.')\"",
    "smoke:staging": "node --env-file=.env.flushcrowd-staging -e \"process.env.GCLOUD_PROJECT='flushcrowd-staging'; require('.')\"",
    "pretest": "npm run build && npm run smoke:entrypoint && npm run smoke:staging",
    "test": "APP_ENV=test node --test lib/test/*.test.js",
    "test:emulators": "firebase emulators:exec --only firestore \"npm test\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^13.31.0",
    "typescript": "^5.6.3"
  }
}
