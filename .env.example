# FlushCrowd Environment Configuration Template
# Copy this file to .env or pass values via dart-define / build arguments.
# DO NOT commit .env or any secret keys to version control.

# Google Maps Platform API Keys
# Must be platform-restricted:
# - Android: Restricted to package name (com.flushcrowd.flushcrowd) and SHA-1 signing fingerprint
# - iOS: Restricted to bundle identifier (com.flushcrowd.flushcrowd)
MAPS_API_KEY_ANDROID=your_restricted_android_maps_api_key_here
MAPS_API_KEY_IOS=your_restricted_ios_maps_api_key_here

# Firebase Configuration (pending staging/production resource creation by project owner)
FIREBASE_PROJECT_ID=your_flushcrowd_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_flushcrowd_firebase_storage_bucket

# Firebase App Check
# Development only: Pass a registered debug token for local testing/emulators
# Production: Handled natively via Play Integrity (Android) and App Attest (iOS)
APP_CHECK_DEBUG_TOKEN=

# App Environment: development | staging | production
APP_ENV=development
